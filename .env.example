# ---- Beyond Style UAE — environment variables ----
# Copy to .env.local and fill in. NEVER commit real keys.

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes / server actions for privileged writes.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider wrapper (pick ONE) ----
# Options: groq | together | openai | openai_compatible | anthropic | gemini | mock
# "mock" needs no key and returns placeholder analysis (good for first run).
# Recommended open-model setup: groq (Llama 3.1 70B) or together (Qwen 2.5 72B).
AI_PROVIDER=mock

# Groq — open models, OpenAI-compatible (Llama 3.1 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Together AI — open models, OpenAI-compatible (Qwen 2.5 72B)
TOGETHER_API_KEY=
TOGETHER_MODEL=Qwen/Qwen2.5-72B-Instruct-Turbo

# Any other OpenAI-compatible endpoint
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ---- Customer form intake webhook (/api/webhook/form-intake) ----
# Optional shared secret. When set, callers must send header x-webhook-secret.
WEBHOOK_SECRET=

# WhatsApp messages + confirmation gate. Provider: meta | mock (default mock = logged only)
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Inbound webhook (/api/webhook/whatsapp): set in Meta → WhatsApp → Configuration.
WHATSAPP_VERIFY_TOKEN=
# App secret to verify X-Hub-Signature-256 on inbound events (recommended).
WHATSAPP_APP_SECRET=

# Email thank-you messages. Provider: resend | mock (default mock = logged only)
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM="Beyond Style UAE <orders@beyondstyle.ae>"

# ---- Order persistence (BOTH targets; each optional, mock-logged if unset) ----
# Supabase intake_orders uses the SUPABASE_SERVICE_ROLE_KEY above.
# Google Sheets mirror ("add lead to Sheet"):
#   - Service account key JSON (raw or base64). Share the sheet with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Form Responses

# Confirmation gate lifecycle (real-time ops).
# Awaiting confirmations older than this are auto-expired (T+24 stock lock).
CONFIRMATION_TTL_HOURS=24
# Max WhatsApp contact attempts before stopping resends (policy: 3).
CONFIRMATION_MAX_ATTEMPTS=3
